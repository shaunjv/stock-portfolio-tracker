<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Row 1: Symbol + Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Symbol -->
            <TextView
                android:id="@+id/tv_alert_symbol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RELIANCE"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tv_alert_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

        </LinearLayout>

        <!-- Row 2: Type Badge + Price -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp">

            <!-- Alert Type Badge -->
            <TextView
                android:id="@+id/tv_alert_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Price Above"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />

            <!-- Target Price -->
            <TextView
                android:id="@+id/tv_alert_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="₹2,900.00"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                android:paddingStart="12dp" />

        </LinearLayout>

        <!-- Row 3: Created date + Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp">

            <!-- Created date -->
            <TextView
                android:id="@+id/tv_alert_created"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="05 May, 09:32 AM"
                android:textSize="12sp"
                android:textColor="@android:color/darker_gray" />

            <!-- Toggle -->
            <ImageButton
                android:id="@+id/btn_alert_toggle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_pause"
                android:contentDescription="Toggle alert"
                android:scaleType="centerInside"
                android:padding="6dp" />

            <!-- Edit -->
            <ImageButton
                android:id="@+id/btn_alert_edit"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_edit"
                android:contentDescription="Edit alert"
                android:scaleType="centerInside"
                android:padding="6dp" />

            <!-- Delete -->
            <ImageButton
                android:id="@+id/btn_alert_delete"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                android:contentDescription="Delete alert"
                android:scaleType="centerInside"
                android:padding="6dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
